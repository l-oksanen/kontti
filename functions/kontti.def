Bootstrap: docker
From: ubuntu:24.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git ripgrep jq less procps unzip xz-utils zstd python3 \
        kitty-terminfo
    rm -rf /var/lib/apt/lists/*
    # elan in the image, the toolchains in ~/.elan of the home: each
    # project names its own (lean-toolchain), which elan installs at the
    # first use. Read-only here, so elan is updated by a new image.
    curl -fsSL https://elan.lean-lang.org/elan-init.sh | ELAN_HOME=/opt/elan \
        sh -s -- -y --default-toolchain none --no-modify-path
    ln -s /opt/elan/bin/* /usr/local/bin/
    # uv likewise: the Pythons (requires-python) and its cache go to the
    # home, the venv of a project into the project
    curl -LsSf https://astral.sh/uv/install.sh | \
        env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh

%environment
    export LANG=C.UTF-8
    export PATH="$HOME/.local/bin:$HOME/.elan/bin:$PATH"
